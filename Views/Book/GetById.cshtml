@model DisplayBookVM
@{
    ViewData["Title"] = Model.Title;
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="card-title">@Model.Title</h2>
        <h6 class="text-muted mb-3">by @string.Join(", ", Model.AuthorNames)</h6>

        <p>@Model.Description</p>

        <dl class="row mb-0">
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.CategoryName</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.PublishYear)</dt>
            <dd class="col-sm-9">@Model.PublishYear</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.ISBN) ? "—" : Model.ISBN)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.AvailableCopies)</dt>
            <dd class="col-sm-9">
                @if (Model.AvailableCopies > 0)
                {
                    <span class="badge bg-success">@Model.AvailableCopies</span>
                }
                else
                {
                    <span class="badge bg-danger">None available</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">← Back</a>

        @if (User.IsInRole("Member"))
        {
            <form asp-controller="Loan" asp-action="Borrow" method="post" class="d-inline">
                <input type="hidden" name="bookId" value="@Model.Id" />
                <button type="submit" class="btn btn-success" disabled="@(Model.AvailableCopies <= 0)">Borrow</button>
            </form>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-success" asp-controller="User" asp-action="SignIn">Sign in to borrow</a>
        }

        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Delete this book?');">
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
        }
    </div>
</div>