@model IEnumerable<DisplayCategoryVM>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Categories</h2>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" asp-action="Create">+ New category</a>
    }
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr><th>Name</th><th>Description</th><th>Books</th><th class="text-end">Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td><a asp-action="GetById" asp-route-id="@c.Id">@c.Name</a></td>
                <td>@c.Description</td>
                <td><span class="badge bg-secondary">@c.BookCount</span></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="GetById" asp-route-id="@c.Id">Details</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this category?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>