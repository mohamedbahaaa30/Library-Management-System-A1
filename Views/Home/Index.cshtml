@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">Welcome to the Library</h1>
    <p class="lead">Browse the catalog, borrow books, and keep track of your loans.</p>
    <a class="btn btn-primary btn-lg" asp-controller="Book" asp-action="Index">Browse books</a>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-outline-secondary btn-lg" asp-controller="User" asp-action="SignUp">Join now</a>
    }
</div>

<div class="row g-3 text-center">
    <div class="col-md-4"><a class="btn btn-outline-dark w-100 py-3" asp-controller="Book" asp-action="Index">Books</a></div>
    <div class="col-md-4"><a class="btn btn-outline-dark w-100 py-3" asp-controller="Author" asp-action="Index">Authors</a></div>
    <div class="col-md-4"><a class="btn btn-outline-dark w-100 py-3" asp-controller="Category" asp-action="Index">Categories</a></div>
</div>